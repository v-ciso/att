generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Names injected by the Vercel + Supabase integration, so nothing has to be
  // copied by hand. `vercel env pull` keeps them in sync.
  // url       = pooled (pgbouncer, port 6543): what the app queries through.
  // directUrl = unpooled (port 5432): required for migrations/db push, which
  //             pgbouncer cannot run.
  // Keep this file ASCII-only. The Prisma CLI rejects non-ASCII characters
  // anywhere in the schema, including comments ("Error: Invalid character").
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  OWNER    // the market owner: full edit, billing contact, sets the campaign
  MANAGER  // edit access to their company's data, no billing/branding
  VIEWER   // read-only: can see every screen, can change nothing
  ASM
  LEAD
  REP
  INTERN
}

enum StoreType {
  COSTCO
  TARGET
  BJS
  CUSTOM
}

enum ExpenseCategory {
  PAYROLL
  RENT
  TRAVEL
  ROADTRIP
  MARKETING
  SOFTWARE
  OTHER
}

enum RoadtripStatus {
  PENDING
  APPROVED
  REIMBURSED
  DENIED
}

enum CommissionCategory {
  PHONE
  FIBER
  OVERRIDE
  STORE
}

enum OverrideType {
  FLAT
  PERCENT
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  ROADTRIP
}

enum SubscriptionTier {
  STANDARD
  WHITE_LABEL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Legacy bcrypt hash. Accounts created through the admin console authenticate
  // via Supabase Auth instead (authId set, passwordHash left blank), so this is
  // optional now. Existing accounts keep using it - see lib/auth.ts dual path.
  passwordHash  String    @default("")
  // Supabase auth.users UUID. When set, the login verifies against Supabase
  // Auth (so the user shows up in the Authentication tab and can be given OAuth
  // / MFA from the Supabase console). When null, the bcrypt hash is used.
  authId        String?   @unique
  // A disabled account cannot sign in even though the row survives (so its
  // history stays intact). Toggled per company from the admin console.
  disabled      Boolean   @default(false)
  name          String
  role          Role      @default(REP)
  employeeId    String?   @unique
  avatarUrl     String?
  teamId        String?
  team          Team?     @relation("TeamMembers", fields: [teamId], references: [id])
  marketOwnerId String?
  marketOwner   MarketOwner? @relation(fields: [marketOwnerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attendances         Attendance[]
  goals               Goal[]
  commissions         Commission[]
  ledTeams            Team[]       @relation("TeamLead")
  leaderboardEntries  LeaderboardEntry[]
}

model MarketOwner {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionTier       SubscriptionTier @default(STANDARD)
  theme                  Json      // White-label config
  // A suspended company (non-payment, offboarding): every login under it is
  // refused, but the rows survive so it can be reinstated without data loss.
  disabled               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  users                  User[]
  teams                  Team[]
  leaderboardEntries     LeaderboardEntry[]
  expenses               Expense[]
  roadtrips              Roadtrip[]
  commissionRules        CommissionRule[]
  goals                  Goal[]
  data                   TenantData[]
  archives               DataArchive[]
  competitions           Competition[]
}

// The recycle bin. Nothing in this app is ever hard-deleted from the UI: every
// rep/store/competition removal and every full-tenant snapshot lands here first
// as a JSON payload, scoped to the company. An OWNER can restore their own
// company's items; only a super-admin can permanently purge (typed confirm +
// reason, logged). kind is a plain string rather than an enum so a new archived
// entity type never needs a migration.
model DataArchive {
  id            String      @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner @relation(fields: [marketOwnerId], references: [id], onDelete: Cascade)
  kind          String      // PERSON | STORE | COMPETITION | TENANT_SNAPSHOT
  refId         String      // the archived entity's own id (person.id, etc.)
  label         String      // human label shown in the recovery list
  payload       Json        // the full entity, restorable as-is
  deletedBy     String      // userId or system marker
  deletedAt     DateTime    @default(now())
  restoredAt    DateTime?
  restoredBy    String?
  purgedAt      DateTime?   // set when a super-admin permanently purges
  purgedBy      String?
  reason        String?     // required on purge, optional on archive

  @@index([marketOwnerId, kind])
  @@index([marketOwnerId, restoredAt])
}

// A floor competition. Live comps are still configured client-side (a derived
// view over live sales), but once ENDED the final standings are frozen into
// these tables so the historical record survives a resync, a rename, or a
// standings recompute. status flows active -> ended -> archived; a comp is
// never hard-deleted. Values are numeric (not the old pre-formatted "$1,240"
// strings) so history can be charted, summed, and fed into the rep profile.
model Competition {
  id            String                @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner           @relation(fields: [marketOwnerId], references: [id], onDelete: Cascade)
  title         String
  prize         String
  metric        String                // lines | premium | internet | nextUps | revenue
  store         String?               // null = all stores
  periodStart   DateTime
  periodEnd     DateTime?
  status        String                @default("active") // active | ended | archived
  createdBy     String
  endedAt       DateTime?
  endedBy       String?
  createdAt     DateTime              @default(now())
  standings     CompetitionStanding[]

  @@index([marketOwnerId, status])
}

model CompetitionStanding {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  personId      String      // stable, employeeCode-backed id - not a name
  personName    String      // denormalised snapshot, so history survives a rename
  store         String?
  rank          Int
  value         Float        // numeric, so it can be charted and compared
  metric        String

  @@unique([competitionId, personId])
}

// Per-company operational data (roster, sales, schedule, attendance, P&L, ...),
// stored as the same JSON blobs the app already uses, one row per (tenant, key).
// This is the tenant's "container": every row is scoped to a marketOwnerId, and
// the API only ever reads/writes the marketOwnerId from the caller's SESSION -
// so company A can never see or touch company B's rows. Cross-device sync comes
// for free because the browser becomes a cache of these rows, not the source.
model TenantData {
  id            String      @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner @relation(fields: [marketOwnerId], references: [id], onDelete: Cascade)
  key           String      // e.g. 'se-people-v1'
  value         Json
  updatedAt     DateTime    @updatedAt

  @@unique([marketOwnerId, key])
  @@index([marketOwnerId])
}

model Team {
  id                String    @id @default(cuid())
  name              String
  color             String    @default("#3B82F6")
  leadId            String
  lead              User      @relation("TeamLead", fields: [leadId], references: [id])
  members           User[]    @relation("TeamMembers")
  marketOwnerId     String
  marketOwner       MarketOwner @relation(fields: [marketOwnerId], references: [id])
  goals             Json      // WeeklyGoals
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leaderboardEntries LeaderboardEntry[]
  teamGoals          Goal[]    @relation("teamGoals")
}

model LeaderboardEntry {
  id            String    @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner @relation(fields: [marketOwnerId], references: [id])
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  rank          Int
  name          String
  store         StoreType
  lines         Int
  premium       Int
  fiber         Int
  commission    Float
  role          Role
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([marketOwnerId, date])
  @@index([marketOwnerId, rank])
}

model Expense {
  id            String          @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner     @relation(fields: [marketOwnerId], references: [id])
  category      ExpenseCategory
  amount        Float
  description   String
  date          DateTime
  isRecurring   Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([marketOwnerId, date])
}

model Roadtrip {
  id            String          @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner     @relation(fields: [marketOwnerId], references: [id])
  name          String
  location      String
  startDate     DateTime
  endDate       DateTime
  totalCost     Float
  reimbursed    Float           // Typically 60%
  status        RoadtripStatus  @default(PENDING)
  attendees     String[]        // User IDs
  createdAt     DateTime        @default(now())

  @@index([marketOwnerId, startDate])
}

model CommissionRule {
  id            String             @id @default(cuid())
  marketOwnerId String
  marketOwner   MarketOwner        @relation(fields: [marketOwnerId], references: [id])
  category      CommissionCategory
  planName      String
  baseAmount    Float
  multiplier    Float              @default(1.0)
  overrideType  OverrideType?
  overrideValue Float?
  appliesToRole Role?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([marketOwnerId, category])
}

model Goal {
  id              String      @id @default(cuid())
  marketOwnerId   String
  marketOwner     MarketOwner @relation(fields: [marketOwnerId], references: [id])
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  teamId          String?
  team            Team?       @relation("teamGoals", fields: [teamId], references: [id])
  period          GoalPeriod
  linesTarget     Int
  premiumTarget   Int
  fiberTarget     Int
  revenueTarget   Float
  attendanceTarget Float     // percentage
  weekStart       DateTime
  createdAt       DateTime    @default(now())

  @@index([marketOwnerId, period, weekStart])
  @@index([marketOwnerId, userId, period])
  @@index([marketOwnerId, teamId, period])
}

model Attendance {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  date      DateTime
  status    AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  createdAt DateTime          @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model Commission {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  period        GoalPeriod
  weekStart     DateTime
  grossAmount   Float
  overrideAmount Float
  netAmount     Float
  breakdown     Json     // Detailed breakdown
  createdAt     DateTime @default(now())

  @@unique([userId, period, weekStart])
  @@index([userId, period])
}
